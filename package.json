{
  "name": "rainsee-pc",
  "version": "1.4.3",
  "sideEffects": false,
  "description": "为桌面端打造的现代浏览体验——轻盈、清爽、本地优先。",
  "keywords": [
    "web-browser",
    "material",
    "electron",
    "react",
    "mobx",
    "styled-components"
  ],
  "homepage": "https://github.com/Auj625197595/rainsee-pc",
  "main": "build/main-launcher.js",
  "author": "Auj625197595 <yjbrowserjyt@gmail.com>", "repository": {
    "type": "git",
    "url": "git+https://github.com/Auj625197595/rainsee-pc.git"
  },
  "bugs": {
    "url": "https://github.com/Auj625197595/rainsee-pc/issues"
  },
  "scripts": {
    "dev-renderer": "cross-env DEV=1 NODE_OPTIONS=--openssl-legacy-provider webpack serve --config webpack.config.renderer.js",
    "dev-webpack": "cross-env DEV=1 NODE_OPTIONS=--openssl-legacy-provider webpack",
    "build-renderer": "cross-env NODE_OPTIONS=--openssl-legacy-provider webpack --config webpack.config.renderer.js",
    "dev": "cross-env START=1 npm run watch",
    "build": "rimraf build && concurrently \"npm run build-renderer\" \"cross-env NODE_OPTIONS=--openssl-legacy-provider webpack\"",
    "ci-build": "node scripts/ci-build.js",
    "start": "electron .",
    "watch": "concurrently \"npm run dev-renderer\" \"npm run dev-webpack\"",
    "test-extension-storage-patch": "node scripts/test-extension-storage-patch.js",
    "test-content-bridge-handshake": "node scripts/test-content-bridge-handshake.js",
    "test-runtime-lifecycle": "node scripts/test-runtime-lifecycle.js",
    "test-memory-lifecycle": "node scripts/test-memory-lifecycle.js",
    "test-external-navigation-permission": "node scripts/test-external-navigation-permission.js",
    "test-offscreen-recovery": "node scripts/test-offscreen-recovery.js",
    "test-dnr-index": "node scripts/test-dnr-index.js",
    "test-tabs-highlight": "node scripts/test-tabs-highlight.js",
    "test-winreg": "node scripts/test-winreg.js",
    "test-native-messaging-lifecycle": "node scripts/test-native-messaging-lifecycle.js",
    "test-download-extension-hold": "node scripts/test-download-extension-hold.js",
    "test-data-location": "node scripts/test-data-location.js",
    "test-profiles": "node scripts/test-profiles.js",
    "test-workspaces": "node scripts/test-workspaces.cjs",
    "test-profile-data-clone": "node scripts/test-profile-data-clone.js",
    "test-browser-history-import": "node scripts/test-browser-history-import.js",
    "test-internal-flags": "node scripts/test-internal-flags.js",
    "test-browser-internal-url": "node scripts/test-browser-internal-url.js",
    "test-autofill-picker": "node scripts/test-autofill-picker.js",
    "test-gesture-recognizer": "node scripts/test-gesture-recognizer.js",
    "test-single-instance": "node scripts/test-single-instance.js",
    "test-window-state": "node scripts/test-window-state.js",
    "test-chrome-windows-create": "node scripts/test-chrome-windows-create.js",
    "compile-win32": "rimraf dist && npm run build && electron-builder -w --x64 --publish never --config.electronDist=node_modules/electron/dist",
    "compile-darwin": "npm run build && electron-builder -m",
    "compile-darwin-signed": "node scripts/build-mac.js",
    "compile-linux": "npm run build && electron-builder -l",
    "lint": "eslint \"src/**/*.ts*\" \"src/**/*.tsx*\"",
    "lint-fix": "npm run lint -- --fix",
    "rebuild": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@babel/core": "^7.14.6",
    "@cliqz/adblocker-electron": "1.34.0",
    "@electron/remote": "^2.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.11",
    "@types/animejs": "^3.1.3",
    "@types/chrome": "0.0.145",
    "@types/crypto-js": "^4.0.1",
    "@types/jszip": "^3.4.1",
    "@types/nedb": "1.8.11",
    "@types/node": "15.12.5",
    "@types/node-fetch": "^3.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "17.0.11",
    "@types/react-dom": "17.0.8",
    "@types/rimraf": "^3.0.0",
    "@types/styled-components": "5.1.10",
    "@typescript-eslint/eslint-plugin": "^4.28.0",
    "@typescript-eslint/parser": "^4.28.0",
    "animejs": "^3.2.1",
    "awesome-node-loader": "^1.1.1",
    "babel-loader": "^8.2.2",
    "concurrently": "^6.2.0",
    "copy-webpack-plugin": "^9.0.1",
    "cross-env": "7.0.3",
    "cross-fetch": "^4.0.0",
    "electron": "^43.1.1",
    "electron-builder": "26.15.3",
    "eslint": "^7.29.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^3.4.0",
    "eslint-plugin-react": "^7.24.0",
    "file-loader": "^6.2.0",
    "file-type": "16.5.0",
    "fork-ts-checker-webpack-plugin": "^6.2.12",
    "html-webpack-plugin": "^5.3.2",
    "icojs": "^0.16.1",
    "jszip": "^3.6.0",
    "mobx": "6.3.2",
    "mobx-react-lite": "3.2.0",
    "nedb": "1.8.0",
    "node-bookmarks-parser": "^2.0.0",
    "node-fetch": "^3.3.2",
    "prettier": "2.3.2",
    "pretty-bytes": "5.6.0",
    "qrcode": "^1.5.4",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-refresh": "^0.18.0",
    "react-windows-controls": "1.1.1",
    "rimraf": "^3.0.2",
    "source-map-support": "^0.5.19",
    "styled-components": "^5.3.0",
    "terser": "^5.7.0",
    "terser-webpack-plugin": "^5.1.4",
    "ts-loader": "^9.2.3",
    "tsconfig-paths-webpack-plugin": "^3.5.1",
    "tldts": "^7.4.8",
    "typescript": "^4.3.4",
    "typescript-plugin-styled-components": "^1.6.0",
    "webpack": "5.40.0",
    "webpack-bundle-analyzer": "^4.4.2",
    "webpack-cli": "4.7.2",
    "webpack-dev-server": "^3.11.2",
    "webpack-merge": "^5.8.0"
  },
  "dependencies": {
    "electron-updater": "^4.6.5",
    "mux.js": "^6.3.0"
  }
}
