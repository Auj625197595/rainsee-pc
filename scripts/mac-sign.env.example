# macOS 签名 + 公证凭据模板
# 复制本文件为 scripts/.mac-sign.env 并填入真实值：
#   cp scripts/mac-sign.env.example scripts/.mac-sign.env
# scripts/.mac-sign.env 已被 .gitignore 忽略，不会提交。

# CSC_LINK: .p12 证书文件的绝对路径（Developer ID Application）
CSC_LINK=/Users/yourname/certs/developer-id.p12

# CSC_KEY_PASSWORD: 导出 .p12 时设置的密码
CSC_KEY_PASSWORD=

# APPLE_ID: 开发者账号邮箱（必须是属于该 Team 的开发者账号，注意核对）
APPLE_ID=

# APPLE_APP_SPECIFIC_PASSWORD: 登录 account.apple.com 生成的应用专用密码
APPLE_APP_SPECIFIC_PASSWORD=

# APPLE_TEAM_ID: 10 位团队标识符（证书详情 / 成员中心可查）
APPLE_TEAM_ID=

# 可选（国内网络）：electron 二进制走 npmmirror 镜像，避免从 GitHub 下载超时
ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/
ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/
