{
  "appId": "com.rainsee.pcbrowser",
  "productName": "雨见浏览器",
  "nsis": {
    "guid": "36820975-1f67-5b1a-887f-6b7db9a305e8",
    "installerLanguages": [
      "zh_CN"
    ],
     "unicode": true,  
    "oneClick": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": false,
    "include": "./static/nsis-installer.nsh",
    "installerIcon": "./static/icons/icon.ico",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "雨见浏览器"
  },
  "asar": true,
  "directories": {
    "output": "dist",
    "buildResources": "static/icons"
  },
  "afterPack": "./removeLocales.js",
  "extraFiles": [
    {
      "from": "src/preloads/preload.js",
      "to": "./resources/app/build/node_modules/electron-chrome-extensions/dist/preload.js"
    },
    {
      "from": "web.koodoreader.com",
      "to": "./resources/app/build/web.koodoreader.com"
    }
  ],
  "extraResources": [
    {
      "from": "static/win-hello.ps1",
      "to": "win-hello.ps1"
    },
    {
      "from": "static/win-credential.ps1",
      "to": "win-credential.ps1"
    }
  ],
  "files": [
    "build/**/*",
    "package.json",
    "static/**/*"
  ],
  "linux": {
    "category": "Network",
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "deb",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "win": {
    "executableName": "雨见浏览器",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}电脑版-${version}-${arch}.${ext}"
  },
  "mac": {
    "category": "public.app-category.navigation",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "entitlements.mac.plist",
    "entitlementsInherit": "entitlements.mac.plist",
    "notarize": true,
    "artifactName": "${productName}电脑版-${version}-${arch}.${ext}",
    "target": [
      { "target": "dmg", "arch": ["x64", "arm64"] },
      { "target": "zip", "arch": ["x64", "arm64"] }
    ]
  },
  "fileAssociations": [
    {
      "name": "Document",
      "description": "Wexond",
      "role": "Viewer",
      "ext": "html"
    },
    {
      "name": "PDF Document",
      "description": "PDF 文档",
      "role": "Viewer",
      "ext": "pdf",
      "icon": "./static/icons/icon.ico"
    }
  ]
}
