{
  "manifest_version": 3,
  "name": "__MSG_ext_name__",
  "version": "1.0.0",
  "default_locale": "en",
  "description": "__MSG_ext_desc__",
  "key": "",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CRX Test (MV3)",
    "default_icon": { "16": "icon.png", "48": "icon.png", "128": "icon.png" }
  },
  "icons": { "16": "icon.png", "48": "icon.png", "128": "icon.png" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "permissions": ["alarms", "storage", "tabs", "declarativeNetRequest", "identity", "userScripts"],
  "host_permissions": ["https://*/*"],
  "optional_permissions": ["cookies"],
  "optional_host_permissions": ["*://*.example.com/*"]
}
